# MarketPulse market-data configuration (Stage 2C). Copy to .env.local to change.
# No secrets are needed: NSE's MCP servers are public and unauthenticated.

# "nse-mcp" uses NSE's official MCP servers with local CSV fallback.
# Any other value (e.g. "local-csv") disables ALL external fetching.
MARKET_DATA_SOURCE=nse-mcp
# Master switch: false disables every request to NSE.
ENABLE_NSE_MCP=true

# Only these exact official endpoints are accepted (allowlist). Any other value
# disables MCP and is reported at /api/market-data/status.
NSE_BHAVCOPY_MCP_URL=https://mcp.nseindia.in/bhavcopy/cm/mcp
NSE_CM_MARKET_MCP_URL=https://mcp.nseindia.in/cmmkt/mcp

# Per-request MCP timeout in ms (1000-60000).
NSE_MCP_TIMEOUT_MS=12000
# Pause after 3 consecutive failures, in ms (0-600000).
NSE_MCP_BREAKER_COOLDOWN_MS=60000

# Transient in-memory caches (never written to disk or SQLite).
# Bhavcopy data changes once per trading day; 30 minutes is conservative.
NSE_HISTORY_CACHE_TTL_SECONDS=1800
# Delayed quotes: NSE crawls about every minute; 60 s avoids redundant calls.
NSE_QUOTE_CACHE_TTL_SECONDS=60
# How long the last good quote may be shown, labelled "Cached — Stale", during an outage.
NSE_QUOTE_STALE_MAX_SECONDS=21600
# Background quote refresh for the selected stock only, while the market is
# open and the tab is visible. 0 disables it.
NSE_QUOTE_AUTO_REFRESH_SECONDS=120
