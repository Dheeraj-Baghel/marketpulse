      "checkConstraints": {
        "daily_prices_positive": {
          "name": "daily_prices_positive",
          "value": "\"daily_prices\".\"open\" > 0 AND \"daily_prices\".\"high\" > 0 AND \"daily_prices\".\"low\" > 0 AND \"daily_prices\".\"close\" > 0"
        },
        "daily_prices_range": {
          "name": "daily_prices_range",
          "value": "\"daily_prices\".\"high\" >= \"daily_prices\".\"low\" AND \"daily_prices\".\"open\" BETWEEN \"daily_prices\".\"low\" AND \"daily_prices\".\"high\" AND \"daily_prices\".\"close\" BETWEEN \"daily_prices\".\"low\" AND \"daily_prices\".\"high\""
        },
        "daily_prices_volume": {
          "name": "daily_prices_volume",
          "value": "\"daily_prices\".\"volume\" IS NULL OR \"daily_prices\".\"volume\" >= 0"
        },
        "daily_prices_date_shape": {
          "name": "daily_prices_date_shape",
          "value": "\"daily_prices\".\"trade_date\" GLOB '[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]'"
        }
      }
